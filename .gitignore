# ==============================================================================
# Python & Bytecode Caches
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# Virtual Environments (Root & Subdirectories)
# ==============================================================================
venv/
env/
ENV/
.venv/
**/venv/
**/.venv/
**/env/

# ==============================================================================
# Node.js & Frontend Artifacts (automation/frontend)
# ==============================================================================
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# ==============================================================================
# Databases, Instance & Local Runtime State
# ==============================================================================
instance/
*.db
*.sqlite
*.sqlite3
users.db
**/users.db

# ==============================================================================
# Robot Framework Test Outputs & Generated Artifacts
# ==============================================================================
output.xml
log.html
report.html
**/output.xml
**/log.html
**/report.html
pabot_results/
selenium-screenshot-*.png
**/selenium-screenshot-*.png

# Dynamic KYC PDFs generated during test runs
automation/tests/dummy_*.pdf
automation/tests/dummy_*.txt

# Exported CSV Reports generated by bots
approved_applications_report.csv
buyer_approved_properties.csv
**/approved_applications_report.csv
**/buyer_approved_properties.csv

# ==============================================================================
# Uploads & Runtime Directories
# ==============================================================================
plotify-real-estate/static/uploads/*
!plotify-real-estate/static/uploads/*.png
!plotify-real-estate/static/uploads/*.jpg
!plotify-real-estate/static/uploads/.gitkeep

automation/api/uploads/*
!automation/api/uploads/.gitkeep

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.*
!.env.example
.flaskenv

# ==============================================================================
# IDE, Editors & OS Generated Files
# ==============================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================================================================
# AI Agent Workspaces & System Caches
# ==============================================================================
.agent/
.agents/
.gemini/

# ==============================================================================
